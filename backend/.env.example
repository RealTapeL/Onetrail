ENVIRONMENT=development
# Never commit a real value for this secret.
APP_SECRET_KEY=replace-with-a-long-random-secret
POSTGRES_PASSWORD=replace-with-local-db-password
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg://hiking_app:replace-with-local-db-password@localhost:5433/hiking_decision
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
ALLOWED_HOSTS=localhost,127.0.0.1
AUTO_CREATE_SCHEMA=true
ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ISSUER=onetrail-api
JWT_AUDIENCE=onetrail-client

# Amap Web Service API key. Keep this server-side; do not expose it to the frontend.
AMAP_API_BASE_URL=https://restapi.amap.com
AMAP_API_KEY=
