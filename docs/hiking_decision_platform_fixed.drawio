<mxfile host="app.diagrams.net"><diagram name="徒步决策辅助平台"><mxGraphModel><root>
<mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="2" value="徒步决策辅助平台&#xa;出发前回答：适不适合、值不值得、怎么去和带什么" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#17324D;fontColor=#FFFFFF;fontSize=20;fontStyle=1" vertex="1" parent="1"><mxGeometry x="40" y="30" width="520" height="90" as="geometry"/></mxCell>
<mxCell id="3" value="用户输入&#xa;日期｜位置｜同行人数&#xa;体能、兴趣、预算" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F4FF;strokeColor=#3D8FD1;fontSize=15;fontStyle=1" vertex="1" parent="1"><mxGeometry x="40" y="180" width="220" height="100" as="geometry"/></mxCell>
<mxCell id="4" value="智能线路推荐｜核心主链路&#xa;天气 API + 地图 MCP + 用户历史数据&#xa;路线匹配排序：难度、天气、偏好、风险" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4ECFF;strokeColor=#9468CC;fontSize=16;fontStyle=1" vertex="1" parent="1"><mxGeometry x="320" y="170" width="300" height="125" as="geometry"/></mxCell>
<mxCell id="5" value="一键生成出发方案&#xa;推荐路线｜适配理由｜交通与接驳&#xa;补给点｜装备清单｜安全提示｜备选方案" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F8EE;strokeColor=#4DA66C;fontSize=15;fontStyle=1" vertex="1" parent="1"><mxGeometry x="680" y="170" width="280" height="125" as="geometry"/></mxCell>
<mxCell id="6" value="路线与社区信息&#xa;路线库、搜索筛选、视频详情、多维评分&#xa;地形标签：垭口/溪谷/碎石坡 + 安全提示&#xa;路线气质投票：出片/故事/自然/挑战" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4D6;strokeColor=#D8A72E;fontSize=14;fontStyle=1" vertex="1" parent="1"><mxGeometry x="40" y="370" width="300" height="155" as="geometry"/></mxCell>
<mxCell id="7" value="约伴与出行协同&#xa;同行点匹配｜拼车/保障车发布&#xa;隐藏联系方式与经济往来&#xa;同行人管理｜临时对话" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4D6;strokeColor=#D8A72E;fontSize=14;fontStyle=1" vertex="1" parent="1"><mxGeometry x="380" y="370" width="280" height="155" as="geometry"/></mxCell>
<mxCell id="8" value="个人数据闭环&#xa;打卡：照片、印象标签、评分&#xa;主页：徒步日历、统计、想去/去过/收藏&#xa;成就墙：6/24 徽章&#xa;反哺用户画像与推荐" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F4FF;strokeColor=#3D8FD1;fontSize=14;fontStyle=1" vertex="1" parent="1"><mxGeometry x="700" y="370" width="260" height="155" as="geometry"/></mxCell>
<mxCell id="9" value="装备比选｜扩展模块&#xa;背包、徒步鞋、帐篷、睡袋&#xa;按场景/品牌/价格/重量比较&#xa;真实评价 + 与路线联动的装备建议" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE8F0;strokeColor=#C95A83;fontSize=14;fontStyle=1" vertex="1" parent="1"><mxGeometry x="40" y="590" width="300" height="135" as="geometry"/></mxCell>
<mxCell id="10" value="基础能力&#xa;登录/注册、品牌页、首页天气推荐&#xa;消息系统、收藏分享、内容审核" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#8B9AA8;fontSize=14;fontStyle=1" vertex="1" parent="1"><mxGeometry x="380" y="590" width="280" height="135" as="geometry"/></mxCell>
<mxCell id="11" value="产品价值：把“想去徒步”转化为“今天就能安全出发”" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9E8;strokeColor=#D8A72E;fontSize=16;fontStyle=1" vertex="1" parent="1"><mxGeometry x="700" y="590" width="260" height="135" as="geometry"/></mxCell>
